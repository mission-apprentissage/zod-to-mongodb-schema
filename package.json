{
  "name": "zod-mongodb-schema",
  "version": "0.0.0",
  "description": "Converts Zod object to MongoDB validation schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mission-apprentissage/zod-to-mongodb-schema.git"
  },
  "author": "Moroine <moroine.bentefrit@beta.gouv.fr>",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10.0.0",
    "yarn": "please-use-npm"
  },
  "scripts": {
    "lint": "eslint --ignore-path .gitignore --cache --ext .js,.ts,.cjs .",
    "lint:fix": "npm run lint -- --fix",
    "prettier:fix": "prettier --write -u .",
    "prettier:check": "prettier --check -u .",
    "release": "semantic-release",
    "postinstall": "husky",
    "test": "vitest",
    "test:ci": "npm run -- test --run",
    "build": "tsup-node --env.NODE_ENV production",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "bson": "^6.0.0",
    "zod": "^3.25.64"
  },
  "dependencies": {
    "json-schema": "^0.4.0",
    "zod-to-json-schema": "^3.21.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "bson": "^6.10.4",
    "eslint": "^8.53.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-zod": "^1.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.5",
    "semantic-release-slack-bot": "^4.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "zod": "^3.25.64"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --ignore-path .gitignore --cache --fix",
      "prettier --write -u"
    ],
    "*": [
      "prettier --write -u"
    ]
  },
  "files": [
    "src/**/*",
    "!src/**/*.test.ts",
    "dist/**/*"
  ]
}
