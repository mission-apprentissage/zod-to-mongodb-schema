{
  "name": "zod-mongodb-schema",
  "version": "0.0.0",
  "description": "Converts Zod object to MongoDB validation schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mission-apprentissage/zod-to-mongodb-schema.git"
  },
  "author": "Moroine <moroine.bentefrit@beta.gouv.fr>",
  "license": "MIT",
  "engines": {
    "node": ">=24.10",
    "npm": ">=11.0.0",
    "yarn": "please-use-npm"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "prettier:fix": "prettier --write -u .",
    "prettier:check": "prettier --check -u .",
    "release": "semantic-release",
    "test": "vitest",
    "test:ci": "npm run -- test --run",
    "build": "tsup-node --env.NODE_ENV production",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "bson": "^7.0.0",
    "zod": "^3.25.64 || ^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@semantic-release/changelog": "^6.0.3",
    "bson": "^7.0.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.23.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17",
    "zod": "^4.3.5"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache --fix",
      "prettier --write -u"
    ],
    "*": [
      "prettier --write -u"
    ]
  },
  "files": [
    "src/**/*",
    "!src/**/*.test.ts",
    "dist/**/*"
  ]
}
