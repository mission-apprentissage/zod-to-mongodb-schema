{
  "name": "zod-mongodb-schema",
  "version": "0.0.0",
  "description": "Converts Zod object to MongoDB validation schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mission-apprentissage/zod-to-mongodb-schema.git"
  },
  "author": "Moroine <moroine.bentefrit@beta.gouv.fr>",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11.0.0",
    "yarn": "please-use-npm"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "prettier:fix": "prettier --write -u .",
    "prettier:check": "prettier --check -u .",
    "release": "semantic-release",
    "postinstall": "husky",
    "test": "vitest",
    "test:ci": "npm run -- test --run",
    "build": "tsup-node --env.NODE_ENV production",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "bson": "^6.0.0",
    "zod": "^3.25.64"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.0",
    "@eslint/js": "^9.28.0",
    "@semantic-release/changelog": "^6.0.3",
    "bson": "^6.10.4",
    "eslint": "^9.28.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import-x": "^4.15.2",
    "eslint-plugin-n": "^17.20.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "zod": "^3.25.64"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache --fix",
      "prettier --write -u"
    ],
    "*": [
      "prettier --write -u"
    ]
  },
  "files": [
    "src/**/*",
    "!src/**/*.test.ts",
    "dist/**/*"
  ]
}
